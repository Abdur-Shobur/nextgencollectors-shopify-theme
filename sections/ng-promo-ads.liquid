{{ 'ng-promo-ads.css' | asset_url | stylesheet_tag }}

<style>
  #ng-promo-{{ section.id }} {
    --ng-promo-gap: {{ section.settings.gap }}px;
    --ng-promo-pad-y: {{ section.settings.padding_y }}px;
    --ng-promo-radius: {{ section.settings.radius }}px;
    --ng-promo-cols: {{ section.settings.columns | default: 2 }};
  }
</style>

<section
  id="ng-promo-{{ section.id }}"
  class="ng-promo-ads"
  data-section-id="{{ section.id }}"
>
  <div class="{{ section.settings.container }}">
    {%- if section.blocks.size > 0 -%}
      <div class="ng-promo-ads__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign bs = block.settings
            assign tag = 'div'
            if bs.link != blank
              assign tag = 'a'
            endif
            assign img_alt = bs.alt_text | default: 'Promo'
          -%}
          <{{ tag }}
            class="ng-promo-ads__card"
            {% if bs.link != blank %}href="{{ bs.link }}"{% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if bs.image != blank -%}
              {{ bs.image | image_url: width: 1400 | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1200, 1400',
                sizes: '(max-width: 767px) 100vw, 50vw',
                alt: img_alt,
                class: 'ng-promo-ads__img'
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'ng-promo-ads__placeholder placeholder-svg' }}
            {%- endif -%}
          </{{ tag }}>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Promo ads",
  "tag": "section",
  "class": "section-ng-promo-ads",
  "max_blocks": 4,
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "default": "container-fluid",
      "options": [
        { "value": "container-fluid", "label": "Default" },
        { "value": "container", "label": "Boxed" },
        { "value": "w-full", "label": "Full width" }
      ]
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "ad",
      "name": "Ad image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Image alt text",
          "default": "Promo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo ads",
      "blocks": [
        { "type": "ad", "settings": { "alt_text": "Promo 1" } },
        { "type": "ad", "settings": { "alt_text": "Promo 2" } }
      ]
    }
  ]
}
{% endschema %}
