{{ 'ng-value-props.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign cols = section.settings.item_per_row | default: 4
  assign use_line_icons = section.settings.use_line_icons
-%}

<style>
  #ng-vp-{{ section.id }} {
    --ng-vp-bar: {{ section.settings.background_color | default: '#f4f1ea' }};
    --ng-vp-accent: {{ section.settings.accent_color | default: settings.color_primary | default: '#d3b566' }};
    --ng-vp-cols: {{ cols }};
  }
</style>

<section
  id="ng-vp-{{ section.id }}"
  class="ng-vp"
  data-section-id="{{ section.id }}"
>
  <div class="{{ section.settings.container }}">
    {%- if section.settings.heading != blank -%}
      <h2 class="ng-vp__heading" style="margin:0 0 1rem;font-size:1.5rem;font-weight:700;text-align:{{ section.settings.header_alignment }};">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    <div class="ng-vp__bar">
      <div class="ng-vp__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign bs = block.settings
            assign tag = 'div'
            if bs.link != blank
              assign tag = 'a'
            endif
            assign icon_type = bs.icon_type | default: 'shipping'
            assign show_image = false
            if bs.image != blank and use_line_icons == false
              assign show_image = true
            endif
          -%}
          <{{ tag }}
            class="ng-vp__card"
            {% if bs.link != blank %}href="{{ bs.link }}"{% endif %}
            {{ block.shopify_attributes }}
          >
            <span class="ng-vp__icon" aria-hidden="true">
              {%- if show_image -%}
                {{ bs.image | image_url: width: 96 | image_tag: loading: 'lazy', alt: bs.title }}
              {%- else -%}
                {%- case icon_type -%}
                  {%- when 'shipping' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M1 7h2l1.5 2h9.5"/><path d="M3 17h1.5"/><path d="M8 17h8"/><path d="M14 9h3l3 3v5h-2"/><circle cx="6.5" cy="17" r="1.5"/><circle cx="17.5" cy="17" r="1.5"/><path d="M3 7v8h2"/></svg>
                  {%- when 'returns' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
                  {%- when 'secure' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8h12v11a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/><path d="m10 14 1.5 1.5L15 12"/></svg>
                  {%- when 'support' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><path d="M4 14v2a2 2 0 0 0 2 2h1v-6H6a2 2 0 0 0-2 2z"/><path d="M20 14v2a2 2 0 0 1-2 2h-1v-6h1a2 2 0 0 1 2 2z"/><path d="M15 19h-2a2 2 0 0 0 2 2"/></svg>
                  {%- when 'price' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><path d="M12 7v10M9.5 9.5c.6-1 1.5-1.5 2.5-1.5 1.4 0 2.5.8 2.5 2s-1.1 2-2.5 2h-1C9.6 12 8.5 12.8 8.5 14s1.1 2 2.5 2c1 0 1.9-.5 2.5-1.5"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 6v5c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6l-7-3z"/></svg>
                {%- endcase -%}
              {%- endif -%}
            </span>

            <div class="ng-vp__content">
              {%- if bs.title != blank -%}
                <h3 class="ng-vp__title">{{ bs.title }}</h3>
              {%- endif -%}
              {%- if bs.description != blank -%}
                <div class="ng-vp__text">{{ bs.description }}</div>
              {%- endif -%}
            </div>
          </{{ tag }}>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Value props",
  "tag": "section",
  "class": "section-ng-value-props",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "default": "container-fluid",
      "options": [
        { "value": "container-fluid", "label": "Default" },
        { "value": "container", "label": "Boxed" },
        { "value": "w-full", "label": "Full width" }
      ]
    },
    {
      "type": "range",
      "id": "item_per_row",
      "label": "Items per row",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "use_line_icons",
      "label": "Use line icons (ignore uploaded images)",
      "default": true,
      "info": "Matches the trust-bar mock. Turn off to use custom icon images."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Bar background",
      "default": "#f4f1ea"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#d3b566"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Value item",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Line icon",
          "default": "shipping",
          "options": [
            { "value": "shipping", "label": "Shipping truck" },
            { "value": "returns", "label": "Returns" },
            { "value": "secure", "label": "Secure / payments" },
            { "value": "support", "label": "Support headset" },
            { "value": "price", "label": "Price" }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom icon image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free Shipping"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>On orders over $50</p>"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value props",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon_type": "shipping",
            "title": "Free Shipping",
            "description": "<p>On orders over $50</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon_type": "returns",
            "title": "Easy Returns",
            "description": "<p>30-day money back</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon_type": "secure",
            "title": "Secure Payments",
            "description": "<p>100% protected checkout</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon_type": "support",
            "title": "24/7 Support",
            "description": "<p>We’re here to help</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
