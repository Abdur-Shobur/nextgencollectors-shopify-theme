{{ 'ng-shop-by.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading
  assign view_all_label = section.settings.view_all_label
  assign view_all_link = section.settings.view_all_link
  assign show_arrows = section.settings.show_arrows
  assign image_fit = section.settings.image_fit
-%}

<style>
  #shop-by-{{ section.id }} {
    --ng-sb-bg: {{ section.settings.background_color | default: '#f7f6f3' }};
    --ng-sb-circle: {{ section.settings.circle_color | default: '#f3f1ec' }};
    --ng-sb-accent: {{ section.settings.accent_color | default: settings.color_primary | default: '#d3b566' }};
    --ng-sb-size: {{ section.settings.item_size }}px;
  }
</style>

<section
  id="shop-by-{{ section.id }}"
  class="ng-shop-by"
  data-ng-shop-by
  data-section-id="{{ section.id }}"
>
  <div class="ng-shop-by__inner {{ section.settings.container }}">
    {%- if heading != blank or view_all_label != blank -%}
      <div class="ng-shop-by__header">
        {%- if heading != blank -%}
          <h2 class="ng-shop-by__title">{{ heading }}</h2>
        {%- endif -%}
        {%- if view_all_label != blank -%}
          <a class="ng-shop-by__view-all" href="{{ view_all_link | default: routes.collections_url }}">
            {{ view_all_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="ng-shop-by__track-wrap">
      {%- if show_arrows -%}
        <button class="ng-shop-by__nav ng-shop-by__nav--prev" type="button" aria-label="Previous" data-ng-shop-by-prev>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button class="ng-shop-by__nav ng-shop-by__nav--next" type="button" aria-label="Next" data-ng-shop-by-next>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      {%- endif -%}

      <div class="ng-shop-by__track" data-ng-shop-by-track>
        {%- for block in section.blocks -%}
          {%- liquid
            assign item_title = blank
            assign item_url = blank
            assign item_image = blank

            if block.type == 'collection'
              assign col = block.settings.collection
              if col != blank
                assign item_title = block.settings.title | default: col.title
                assign item_url = col.url
                if block.settings.image != blank
                  assign item_image = block.settings.image
                elsif col.featured_image != blank
                  assign item_image = col.featured_image
                elsif col.products.first and col.products.first.featured_image
                  assign item_image = col.products.first.featured_image
                endif
              endif
            else
              assign item_title = block.settings.title
              assign item_url = block.settings.link
              assign item_image = block.settings.image
            endif
          -%}

          {%- if item_title != blank or item_image != blank -%}
            <a
              class="ng-shop-by__item"
              href="{{ item_url | default: '#' }}"
              {{ block.shopify_attributes }}
            >
              <span class="ng-shop-by__circle{% if image_fit == 'cover' %} ng-shop-by__circle--cover{% endif %}">
                {%- if item_image != blank -%}
                  {{ item_image | image_url: width: 400 | image_tag:
                    loading: 'lazy',
                    widths: '120, 180, 240, 320, 400',
                    sizes: '(max-width: 767px) 26vw, 140px',
                    alt: item_title
                  }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </span>
              {%- if item_title != blank -%}
                <span class="ng-shop-by__label">{{ item_title }}</span>
              {%- endif -%}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script src="{{ 'ng-shop-by.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Shop by circles",
  "tag": "section",
  "class": "section-ng-shop-by",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View all categories →"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "default": "container-fluid",
      "options": [
        { "value": "container-fluid", "label": "Default" },
        { "value": "container", "label": "Boxed" },
        { "value": "w-full", "label": "Full width" }
      ]
    },
    {
      "type": "range",
      "id": "item_size",
      "label": "Circle size (desktop)",
      "min": 80,
      "max": 160,
      "step": 4,
      "default": 128,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "contain",
      "options": [
        { "value": "contain", "label": "Contain (products / logos)" },
        { "value": "cover", "label": "Cover (fill circle)" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows (desktop)",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f7f6f3"
    },
    {
      "type": "color",
      "id": "circle_color",
      "label": "Circle background",
      "default": "#f3f1ec"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#d3b566"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title",
          "info": "Leave blank to use collection title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Leave blank to use collection image"
        }
      ]
    },
    {
      "type": "custom",
      "name": "Custom item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by circles",
      "blocks": [
        { "type": "custom", "settings": { "title": "Gold" } },
        { "type": "custom", "settings": { "title": "Silver" } },
        { "type": "custom", "settings": { "title": "Copper" } },
        { "type": "custom", "settings": { "title": "Accessories" } },
        { "type": "custom", "settings": { "title": "Australian Coins" } },
        { "type": "custom", "settings": { "title": "Germania Mint" } },
        { "type": "custom", "settings": { "title": "Perth Mint" } },
        { "type": "custom", "settings": { "title": "Mint XXI" } }
      ]
    }
  ]
}
{% endschema %}
